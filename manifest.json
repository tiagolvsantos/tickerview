{
  "manifest_version": 3,
  "name": "TickerView",
  "version": "2.2.0",
  "description": "Hover over stock tickers to see real-time technical stats and charts.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://query1.finance.yahoo.com/*",
    "https://query2.finance.yahoo.com/*",
    "https://finance.yahoo.com/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "TickerView \u00b7 Cerberus"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.twitter.com/*",
        "https://*.x.com/*",
        "https://*.reddit.com/*",
        "https://*.finance.yahoo.com/*",
        "https://*.stocktwits.com/*",
        "https://*.seekingalpha.com/*",
        "https://*.investing.com/*",
        "https://*.tradingview.com/*",
        "https://*.marketwatch.com/*",
        "https://*.bloomberg.com/*",
        "https://*.cnbc.com/*",
        "https://*.wsj.com/*",
        "https://*.reuters.com/*",
        "https://*.benzinga.com/*",
        "https://*.fool.com/*",
        "https://*.finviz.com/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "css": [
        "brand.css",
        "styles.css"
      ],
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon48.png",
        "icons/icon128.png",
        "fonts/Montserrat.ttf",
        "fonts/IBMPlexMono-Regular.ttf"
      ],
      "matches": [
        "https://*.twitter.com/*",
        "https://*.x.com/*",
        "https://*.reddit.com/*",
        "https://*.finance.yahoo.com/*",
        "https://*.stocktwits.com/*",
        "https://*.seekingalpha.com/*",
        "https://*.investing.com/*",
        "https://*.tradingview.com/*",
        "https://*.marketwatch.com/*",
        "https://*.bloomberg.com/*",
        "https://*.cnbc.com/*",
        "https://*.wsj.com/*",
        "https://*.reuters.com/*",
        "https://*.benzinga.com/*",
        "https://*.fool.com/*",
        "https://*.finviz.com/*"
      ]
    }
  ],
  "commands": {
    "open-search": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Open TickerView ticker search"
    }
  }
}
